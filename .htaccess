# ==========================================
# Stayora Production Apache Configuration
# Optimized for Performance, Security & SEO
# ==========================================

# 1. Disable directory browsing
Options -Indexes

# 2. Block access to sensitive files and directories
<FilesMatch "(^\.env|^\.git|\.sql$|\.log$|\.lock$|\.md$|composer\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Block direct access to internal database & storage logs
RedirectMatch 403 ^/(database|storage/logs)/

# 4. Gzip / Deflate Compression (Crucial for Google Core Web Vitals & PageSpeed)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# 5. Browser Caching / Leverage Browser Caching (mod_expires & mod_headers)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML dynamic documents
    ExpiresByType text/html "access plus 0 seconds"

    # Data feeds & XML
    ExpiresByType text/xml "access plus 1 hour"
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType application/json "access plus 1 hour"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # Media: Images, Icons, Video
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"

    # Web Fonts
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# 6. Security Headers (Search Engine Favored)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 7. Standard URL Rewriting & Clean Routing
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to dot-files/folders
    RewriteRule (^\.|/\.) - [F]

    # Explicit rule for sitemap.xml and robots.txt to ensure clean serving
    RewriteRule ^sitemap\.xml$ index.php [QSA,L]
    RewriteRule ^robots\.txt$ index.php [QSA,L]

    # Serve existing physical files or directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route all other traffic through index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>