# ==========================================
# Farmlelo Local Environment Configuration
# ==========================================

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=Stayora
DB_USER=root
DB_PASS=

# Application Settings
APP_NAME="Stayora"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# ==========================================
# SMS Gateway Selection (msg91 | twilio)
# ==========================================
SMS_DRIVER=msg91

# ==========================================
# MSG91 SMS & OTP Configuration
# ==========================================
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=FRMLEL

# ==========================================
# Twilio SMS API Configuration (Fallback)
# ==========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_FROM_NUMBER=+17372212163

# ==========================================
# Mail / SMTP Configuration (Placeholders)
# ==========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=yourdomain@email.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@stayora.com
MAIL_FROM_NAME="Stayora Support"
